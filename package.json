{
  "name": "sap-purchase-orders",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"tsx watch src/server.ts\" \"vite --config web/vite.config.ts\"",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc --project tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/src/server.js",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "vitest run",
    "test:frontend": "vitest run --config web/vitest.config.ts",
    "test:phase4": "vitest run tests/integration tests/llm",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tests/tsconfig.browser.json && tsc --noEmit --project web/tsconfig.json",
    "demo": "tsx demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.12.7",
    "openai": "^6.49.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  }
}
